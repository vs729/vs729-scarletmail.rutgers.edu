/* Overall Website */
body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #243447;

    background:
        radial-gradient(circle at 10% 20%, rgba(31, 60, 91, 0.12), transparent 25%),
        radial-gradient(circle at 90% 80%, rgba(31, 60, 91, 0.10), transparent 25%),
        linear-gradient(135deg, #eef3f7, #ffffff);

    min-height: 100vh;
}

/* Header */
header {
    text-align: center;
    padding: 45px 20px 25px;
}

header h1 {
    color: #1f3c5b;
    font-size: 38px;
    margin: 0;
}

/* Main Content */
main {
    max-width: 900px;
    margin: auto;
    padding: 20px;
}

/* Sections */
section {
    background: rgba(255, 255, 255, 0.9);
    padding: 30px;
    margin-bottom: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

/* Section Headings */
h2 {
    color: #1f3c5b;
    border-bottom: 2px solid #d6e1ea;
    padding-bottom: 8px;
}

h3 {
    color: #315a7d;
}

/* Paragraphs */
p {
    line-height: 1.7;
}

/* Lists */
ol {
    line-height: 1.8;
}

/* Profile Picture */
.profile {
    text-align: center;
    margin: 20px 0 30px;
}

.profile img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid white;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

/* Links */
a {
    color: #1f5f8b;
    text-decoration: none;
    font-weight: bold;
}

a:hover {
    text-decoration: underline;
}

/* Project Articles */
article {
    background: #f7f9fb;
    padding: 20px;
    margin-top: 20px;
    border-left: 4px solid #315a7d;
    border-radius: 8px;
}
