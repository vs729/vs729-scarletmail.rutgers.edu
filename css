body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #222;

    background: linear-gradient(
        135deg,
        #e8f0f7,
        #ffffff,
        #dce8f2
    );

    min-height: 100vh;
}

.profile {
    text-align: center;
    margin: 30px 0;
}

.profile img {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid white;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
}
